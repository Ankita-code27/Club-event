# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK credentials (from a service account key).
# Keep these ONLY on the server. Never commit real values.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the \n line breaks exactly as in the downloaded key file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
